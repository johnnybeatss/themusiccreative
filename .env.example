# Supabase project (wired up in Phase 2) — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. NEVER prefix with NEXT_PUBLIC_, never commit,
