# Supabase project (wired up in Phase 2) — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. NEVER prefix with NEXT_PUBLIC_, never commit,
# never expose to the browser. Used by scripts/dev-login-link.mjs (generates a
# local magic-link sign-in URL without sending an email) and by
# src/lib/supabase/serviceClient.ts (the weekly email cron route, which runs
# with no logged-in user/session).
SUPABASE_SERVICE_ROLE_KEY=

# Fixed production origin for magic-link emails (src/app/eboard/login/page.tsx)
# and for links built into the weekly email (src/app/api/cron/weekly-email-draft).
# Must ALSO be set in Vercel > Project Settings > Environment Variables
# (Production) — .env.local is gitignored and never reaches the deployed build.
NEXT_PUBLIC_SITE_URL=

# Resend API key (Full access) — server-side only, never expose to the browser.
# Used by src/app/api/newsletter/subscribe/route.ts to add signups, and by
# the weekly email cron route (src/app/api/cron/weekly-email-draft) to
# create/send Broadcasts. Must ALSO be set in Vercel > Project Settings >
# Environment Variables (Production) — .env.local never reaches the deployed build.
RESEND_API_KEY=

# The Resend Audience/Segment ID that weekly email broadcasts are sent to.
# Resend dashboard > Audiences (or Segments) > copy the ID. This is the
# audience newsletter signups should land in via resend.contacts.create() —
# if subscribers aren't currently assigned to a specific audience, create one
# in Resend and update src/app/api/newsletter/subscribe/route.ts to pass it,
# otherwise broadcasts sent to this ID may miss existing signups.
RESEND_AUDIENCE_ID=

# Verified sender for weekly emails, e.g. "The Music Creative <updates@themusiccreative.org>".
# The domain must be verified in Resend (Domains tab) before you can send
# from it — sending will fail with an unverified domain.
RESEND_FROM_EMAIL=

# Locks down src/app/api/cron/weekly-email-draft so only Vercel's own
# scheduler can trigger it (Vercel sends this as a Bearer token automatically
# once set in Vercel > Project Settings > Environment Variables >
# CRON_SECRET). Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Powers the owner-only /eboard/analytics page (src/lib/vercelAnalytics.ts),
# which queries Vercel's Web Analytics API for the traffic already being
# collected by @vercel/analytics. Must ALSO be set in Vercel > Project
# Settings > Environment Variables (Production) — .env.local never reaches
# the deployed build.

# Access token — server-side only, never expose to the browser.
# Create at vercel.com/account/tokens.
VERCEL_API_TOKEN=

# Project Settings > General > Project ID (starts with "prj_").
VERCEL_PROJECT_ID=

# Only needed if this project lives under a Vercel Team (not a personal
# account) — leave unset otherwise. Accepts either the team ID (starts
# with "team_") or the team's slug, visible in your Vercel dashboard URL
# (vercel.com/<slug>/...).
VERCEL_TEAM_ID_OR_SLUG=
