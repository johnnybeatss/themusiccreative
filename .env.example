# Supabase project (wired up in Phase 2) — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. NEVER prefix with NEXT_PUBLIC_, never commit,
# never expose to the browser. Only real use right now: scripts/dev-login-link.mjs
# (generates a local magic-link sign-in URL without sending an email).
SUPABASE_SERVICE_ROLE_KEY=
